rules_version = '2';

// Interview Trainer — progress sync rules.
//
// Grants exactly one thing: a signed-in user may read and write the single
// document whose ID is their own uid. Everything else stays denied, because
// Firestore denies by default — no catch-all rule is needed (and a trailing
// `allow ...: if false` would be a no-op, since allow rules are OR'd).
//
// Note: deploying rules REPLACES a database's entire ruleset; it never merges.

service cloud.firestore {
  match /databases/{database}/documents {

    match /interviewTrainerUsers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
